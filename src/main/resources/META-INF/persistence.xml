<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                   https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">

    <persistence-unit name="RestaurantPU"
                      transaction-type="RESOURCE_LOCAL">

        <provider>
            org.hibernate.jpa.HibernatePersistenceProvider
        </provider>

        <!-- Entites gerees par JPA -->
        <class>ma.restaurant.model.Utilisateur</class>
        <class>ma.restaurant.model.Plat</class>

        <properties>

            <!-- Configuration MySQL (Driver uniquement, la connexion est injectée dynamiquement) -->
            <property name="jakarta.persistence.jdbc.driver"
                      value="com.mysql.cj.jdbc.Driver"/>

            <!-- Valider le schéma existant sans le modifier -->
            <property name="hibernate.hbm2ddl.auto"
                      value="validate"/>

            <!-- Afficher les requêtes SQL -->
            <property name="hibernate.show_sql"
                      value="true"/>

            <property name="hibernate.format_sql"
                      value="true"/>

        </properties>

    </persistence-unit>

</persistence>
